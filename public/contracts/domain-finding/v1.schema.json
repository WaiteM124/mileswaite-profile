{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai.mileswaite.net/contracts/domain-finding/v1.schema.json",
  "title": "DomainFinding",
  "description": "Proposed, transport-independent domain-analysis artefact for the decision-intelligence design study.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "message_id",
    "decision_brief_id",
    "correlation_id",
    "causation_id",
    "trace_id",
    "producer",
    "created_at",
    "finding_id",
    "finding_version",
    "domain",
    "finding",
    "evidence",
    "assumptions",
    "uncertainty",
    "confidence",
    "review",
    "authority"
  ],
  "properties": {
    "contract": {
      "const": "domain-finding/v1"
    },
    "message_id": {
      "type": "string",
      "format": "uuid"
    },
    "decision_brief_id": {
      "type": "string",
      "format": "uuid"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "causation_id": {
      "type": "string",
      "format": "uuid"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_id",
        "role",
        "instance_id"
      ],
      "properties": {
        "agent_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "const": "domain_agent"
        },
        "instance_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "finding_id": {
      "type": "string",
      "format": "uuid"
    },
    "finding_version": {
      "type": "integer",
      "minimum": 1
    },
    "domain": {
      "enum": [
        "financial",
        "commercial",
        "operational",
        "risk"
      ]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "scope",
        "implications"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "implications": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "source_type",
          "locator",
          "captured_at",
          "provenance_status",
          "summary"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "pattern": "^ev-[a-z0-9-]+$"
          },
          "source_type": {
            "enum": [
              "system_record",
              "document",
              "external_source",
              "human_input",
              "scenario_assumption"
            ]
          },
          "locator": {
            "type": "string",
            "format": "uri"
          },
          "captured_at": {
            "type": "string",
            "format": "date-time"
          },
          "provenance_status": {
            "enum": [
              "observed",
              "derived",
              "illustrative"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assumption_id",
          "statement",
          "sensitivity"
        ],
        "properties": {
          "assumption_id": {
            "type": "string",
            "pattern": "^asm-[a-z0-9-]+$"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "sensitivity": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          }
        }
      }
    },
    "uncertainty": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "statement",
          "materiality",
          "resolution"
        ],
        "properties": {
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "materiality": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "resolution": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "band",
        "rationale"
      ],
      "properties": {
        "band": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "revision_round"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "under_review",
            "accepted",
            "revision_requested"
          ]
        },
        "revision_round": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "may_commit_capital",
        "may_approve_expenditure",
        "may_execute"
      ],
      "properties": {
        "may_commit_capital": {
          "const": false
        },
        "may_approve_expenditure": {
          "const": false
        },
        "may_execute": {
          "const": false
        }
      }
    }
  }
}
