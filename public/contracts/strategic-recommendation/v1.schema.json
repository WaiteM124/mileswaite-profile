{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai.mileswaite.net/contracts/strategic-recommendation/v1.schema.json",
  "title": "StrategicRecommendation",
  "description": "Proposed conditional recommendation. It cannot encode human approval or authorise execution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "message_id",
    "decision_brief_id",
    "correlation_id",
    "causation_id",
    "trace_id",
    "producer",
    "created_at",
    "recommendation_id",
    "based_on",
    "review",
    "recommendation",
    "assumptions",
    "uncertainties",
    "monitoring",
    "human_decision",
    "execution",
    "authority"
  ],
  "properties": {
    "contract": {
      "const": "strategic-recommendation/v1"
    },
    "message_id": {
      "type": "string",
      "format": "uuid"
    },
    "decision_brief_id": {
      "type": "string",
      "format": "uuid"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "causation_id": {
      "type": "string",
      "format": "uuid"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_id",
        "role",
        "instance_id"
      ],
      "properties": {
        "agent_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "const": "strategic_agent"
        },
        "instance_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "recommendation_id": {
      "type": "string",
      "format": "uuid"
    },
    "based_on": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "finding_version",
          "domain"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "format": "uuid"
          },
          "finding_version": {
            "type": "integer",
            "minimum": 1
          },
          "domain": {
            "enum": [
              "financial",
              "commercial",
              "operational",
              "risk"
            ]
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "review_rounds",
        "challenge_ids",
        "unresolved_disagreement"
      ],
      "properties": {
        "status": {
          "enum": [
            "in_progress",
            "blocked",
            "completed",
            "completed_with_unresolved_disagreement"
          ]
        },
        "review_rounds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "challenge_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "uniqueItems": true
        },
        "unresolved_disagreement": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "topic",
              "positions",
              "why_unresolved"
            ],
            "properties": {
              "topic": {
                "type": "string",
                "minLength": 1
              },
              "positions": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "why_unresolved": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed_with_unresolved_disagreement"
              }
            }
          },
          "then": {
            "properties": {
              "unresolved_disagreement": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            }
          },
          "then": {
            "properties": {
              "unresolved_disagreement": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "rationale",
        "conditions",
        "alternatives_considered"
      ],
      "properties": {
        "decision": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "alternatives_considered": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "option",
              "reason_not_selected"
            ],
            "properties": {
              "option": {
                "type": "string",
                "minLength": 1
              },
              "reason_not_selected": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "uncertainties": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "monitoring": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "trigger_id",
          "condition",
          "action",
          "owner_role"
        ],
        "properties": {
          "trigger_id": {
            "type": "string",
            "pattern": "^trg-[a-z0-9-]+$"
          },
          "condition": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "enum": [
              "reopen_decision",
              "pause_execution",
              "notify_owner"
            ]
          },
          "owner_role": {
            "const": "human_decision_owner"
          }
        }
      }
    },
    "human_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "decision_ref"
      ],
      "properties": {
        "status": {
          "const": "pending"
        },
        "decision_ref": {
          "type": "null"
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "execution_ref"
      ],
      "properties": {
        "status": {
          "const": "not_authorised"
        },
        "execution_ref": {
          "type": "null"
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "may_commit_capital",
        "may_approve_expenditure",
        "may_execute"
      ],
      "properties": {
        "may_commit_capital": {
          "const": false
        },
        "may_approve_expenditure": {
          "const": false
        },
        "may_execute": {
          "const": false
        }
      }
    }
  }
}
